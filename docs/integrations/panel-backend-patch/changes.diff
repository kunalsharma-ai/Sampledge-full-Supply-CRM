index 0000000..a3cdd69
--- /dev/null
+++ b/integration/projectStatus.js
@@ -0,0 +1,69 @@
+/**
+ * Project status for Sampledge: counts per market and quota from Response, joined to the
+ * SurveyProject's targets. One aggregation, no personal data.
+ */
+const COUNT_KEYS = { invited: "invited", started: "started", complete: "complete", terminate: "terminate", overquota: "overquota", qualityterminate: "qualityTerminate", dropout: "dropout" };
+
+function median(xs) {
+    const v = xs.filter((x) => typeof x === "number" && x > 0).sort((a, b) => a - b);
+    if (!v.length) return null;
+    const m = Math.floor(v.length / 2);
+    return Math.round((v.length % 2 ? v[m] : (v[m - 1] + v[m]) / 2) * 10) / 10;
+}
+
+/**
+ * @param Response      the Response model
+ * @param SurveyProject the SurveyProject model
+ * @param pid           Sampledge project id
+ * @returns the project status object, or null if the project is unknown
+ */
+export async function projectStatus({ Response, SurveyProject }, pid) {
+    const project = await SurveyProject.findOne({ pid }).lean();
+    if (!project) return null;
+    const rows = await Response.aggregate([
+        { $match: { "project.pid": pid } },
+        {
+            $group: {
+                _id: { marketID: "$project.marketID", quotaID: "$project.quotaID", status: "$status" },
+                n: { $sum: 1 },
+                lastAt: { $max: "$timeline.end" },
+                lois: { $push: { $cond: [{ $and: [{ $eq: ["$status", "complete"] }, { $ne: ["$timeline.end", null] }] }, { $divide: [{ $subtract: ["$timeline.end", "$timeline.start"] }, 60000] }, null] } },
+            },
+        },
+    ]);
+    const markets = (project.markets ?? []).map((m) => {
+        const mine = rows.filter((r) => r._id.marketID === m.marketID);
+        const counts = Object.fromEntries(Object.values(COUNT_KEYS).map((k) => [k, 0]));
+        let lastCompleteAt = null;
+        const lois = [];
+        for (const r of mine) {
+            const key = COUNT_KEYS[r._id.status];
+            if (key) counts[key] += r.n;
+            if (r._id.status === "complete") {
+                lois.push(...r.lois);
+                if (r.lastAt && (!lastCompleteAt || r.lastAt > lastCompleteAt)) lastCompleteAt = r.lastAt;
+            }
+        }
+        // Everyone who started is counted as started: started-only plus every finished outcome.
+        counts.started += counts.complete + counts.terminate + counts.overquota + counts.qualityTerminate + counts.dropout;
+        counts.invited += counts.started;
+        const screened = counts.complete + counts.terminate;
+        return {
+            marketID: m.marketID,
+            status: m.status ?? project.status,
+            target: m.completes ?? null,
+            counts,
+            medianLoiMinutes: median(lois),
+            // Incidence = complete / (complete + terminate). Overquota and quality terminates are excluded.
+            incidence: screened ? Math.round((counts.complete / screened) * 1000) / 1000 : null,
+            quotas: (m.quotas ?? []).map((q) => ({
+                quotaID: q.quotaID,
+                label: q.label ?? null,
+                target: q.target ?? null,
+                complete: mine.filter((r) => r._id.quotaID === q.quotaID && r._id.status === "complete").reduce((a, r) => a + r.n, 0),
+            })),
+            lastCompleteAt: lastCompleteAt ? new Date(lastCompleteAt).toISOString() : null,
+        };
+    });
+    return { pid, status: project.status, markets, asOf: new Date().toISOString() };
+}
diff --git a/integration/serializers.js b/integration/serializers.js
new file mode 100644
index 0000000..0377a37
--- /dev/null
+++ b/integration/serializers.js
@@ -0,0 +1,114 @@
+/**
+ * The objects the backend returns to Sampledge. Each one copies only allowed fields from the stored
+ * document (an allowlist), so a field added to a model later is never exposed by accident.
+ * Never returned: name, email, phone, date of birth, address and GPS, profile picture, payment
+ * details, parent details, passwords and tokens, socials, referrer, notification identities.
+ */
+import { ageBand, ageParts, hasConsent } from "./fields.js";
+import { toCountryCode } from "./country.js";
+
+const iso = (d) => (d ? new Date(d).toISOString() : null);
+const lower = (v) => (v ? String(v).toLowerCase() : null);
+const primaryAddress = (doc) => (Array.isArray(doc?.address) && doc.address.length ? doc.address[0] : null);
+
+function location(doc) {
+    const a = primaryAddress(doc);
+    return {
+        countryCode: a?.countryCode ?? toCountryCode(a?.country) ?? null,
+        region: a?.region ?? null,
+    };
+}
+
+function minorInfo(doc) {
+    const a = ageParts(doc?.dob);
+    const isMinor = a ? a.years < 18 : null;
+    let parentalConsent = "not_required";
+    if (isMinor) parentalConsent = doc?.parent?.consent === true ? "granted" : doc?.parent?.consent === false ? "refused" : "pending";
+    return { isMinor, parentalConsent };
+}
+
+const verified = (v) => ({
+    email: v?.email === "verified",
+    phone: v?.phone === "verified",
+    video: v?.video === "verified",
+    inPerson: v?.inPersonVisit === "verified",
+});
+
+/** The pseudonymous fields every respondent object shares. */
+function baseProfile(doc, panel) {
+    return {
+        respondentID: doc?.respondentID ?? null,
+        panel,
+        ...location(doc),
+        ageBand: ageBand(doc?.dob),
+        gender: lower(doc?.gender),
+    };
+}
+
+/**
+ * Respondent profile for Sampledge.
+ * @param doc     User (t2o, mfr) or Respondent (mho) document
+ * @param panel   "t2o" | "mfr" | "mho"
+ * @param answers optional [{question, answer: [..]}] from Answers (load with .select("+answer"))
+ */
+export function toRespondentProfile(doc, panel, answers = []) {
+    const isHealth = panel === "mho";
+    const consents = {
+        invitations: hasConsent(doc, "survey_invitations"),
+        profiling: hasConsent(doc, "profiling"),
+        clientSharing: hasConsent(doc, "client_sharing"),
+        ...(isHealth && { healthData: hasConsent(doc, "health_data") }),
+    };
+    // Profile answers go out only with consent to share; on MHO also with explicit health-data consent.
+    const mayShareAnswers = consents.clientSharing && (!isHealth || consents.healthData);
+    const out = {
+        ...baseProfile(doc, panel),
+        category: isHealth ? "healthcare" : lower(doc?.category),
+        qualityScore: typeof doc?.qualityScore === "number" ? doc.qualityScore : null,
+        verified: verified(doc?.isVerified),
+        ...minorInfo(doc),
+        joinedMonth: doc?.createdAt ? iso(doc.createdAt).slice(0, 7) : null,
+        accountStatus: doc?.accountStatus ?? "active",
+        lastActiveMonth: doc?.lastActiveAt ? iso(doc.lastActiveAt).slice(0, 7) : null,
+        consents,
+        answers: mayShareAnswers ? answers.map((a) => ({ question: a.question, values: [].concat(a.answer ?? []) })) : [],
+    };
+    if (isHealth) {
+        out.respondentType = doc?.category ?? null; // Professional | Care Giver | Patient
+        out.hcpVerification = doc?.category === "Professional" ? { status: doc?.hcpVerification?.status ?? "unverified", method: doc?.hcpVerification?.method ?? null } : null;
+        delete out.isMinor; delete out.parentalConsent; // MHO has no minors flow
+    }
+    return out;
+}
+
+/**
+ * One response row for Sampledge's response feed.
+ * @param response Response document
+ * @param user     the respondent's User/Respondent document (for the pseudonymous profile)
+ */
+export function toResponseExport(response, user, panel) {
+    const start = response?.timeline?.start ?? null;
+    const end = response?.timeline?.end ?? null;
+    const loiMinutes = start && end ? Math.round(((new Date(end) - new Date(start)) / 60000) * 10) / 10 : (response?.loi || null);
+    const p = baseProfile(user, panel);
+    return {
+        responseID: String(response?._id ?? ""),
+        respondentID: p.respondentID,
+        pid: response?.project?.pid ?? null,
+        marketID: response?.project?.marketID ?? null,
+        quotaID: response?.project?.quotaID ?? null,
+        surveySlug: response?.survey?.slug ?? null,
+        status: response?.status ?? null,
+        qualityReasons: [...(response?.qualityReasons ?? [])],
+        start: iso(start),
+        end: iso(end),
+        loiMinutes,
+        deviceType: response?.deviceType ?? null,
+        points: response?.points ?? 0,
+        profile: { countryCode: p.countryCode, region: p.region, ageBand: p.ageBand, gender: p.gender, category: panel === "mho" ? user?.category ?? null : lower(user?.category) },
+        updatedAt: iso(response?.statusChangedAt ?? response?.updatedAt),
+    };
+}
+
+/** Wraps data in the backend's existing envelope. */
+export const envelope = (data, message = "OK") => ({ status: "success", message, data });
diff --git a/migrations/2026-10-31-sampledge-fields.js b/migrations/2026-10-31-sampledge-fields.js
new file mode 100644
index 0000000..0a16a38
--- /dev/null
+++ b/migrations/2026-10-31-sampledge-fields.js
@@ -0,0 +1,89 @@
+/**
+ * One-off migration for the Sampledge integration fields.
+ *
+ *   node migrations/2026-10-31-sampledge-fields.js            # dry run: prints what would change
+ *   node migrations/2026-10-31-sampledge-fields.js --apply    # writes
+ *   ... --apply --legacy-consent=<policyVersion>              # also see step 5
+ *
+ * Env: MONGO_URI. Collection names default to Mongoose's (users, respondents, responses); override
+ * with USERS_COLLECTION, RESPONDENTS_COLLECTION, RESPONSES_COLLECTION.
+ *
+ * Steps
+ *  1. respondents: rename the misspelled `concent` to `consent`.
+ *  2. users + respondents: set accountStatus ("deleted" where isDeleted is true, else "active").
+ *  3. users + respondents: fill address.countryCode from the free-text country; lists what it could not map.
+ *  4. responses: set statusChangedAt from updatedAt (or createdAt) where missing.
+ *  5. Optional, off by default: existing panelists have no consent records, so feasibility counts them
+ *     as not reachable. If your sign-up terms already covered survey invitations, --legacy-consent
+ *     records that consent with the policy version you name and channel "legacy_terms", only for
+ *     people who accepted terms. This is your legal call; the script never assumes it.
+ */
+import mongoose from "mongoose";
+import { toCountryCode } from "../integration/country.js";
+
+const APPLY = process.argv.includes("--apply");
+const legacyArg = process.argv.find((a) => a.startsWith("--legacy-consent="));
+const LEGACY_POLICY = legacyArg ? legacyArg.split("=")[1] : null;
+const names = {
+    users: process.env.USERS_COLLECTION || "users",
+    respondents: process.env.RESPONDENTS_COLLECTION || "respondents",
+    responses: process.env.RESPONSES_COLLECTION || "responses",
+};
+
+export async function migrate(db, { apply = APPLY, legacyPolicy = LEGACY_POLICY, log = console.log } = {}) {
+    const report = { apply, renamedConcent: 0, accountStatus: 0, countryCodes: 0, unmappedCountries: {}, statusChangedAt: 0, legacyConsent: 0 };
+    const users = db.collection(names.users), respondents = db.collection(names.respondents), responses = db.collection(names.responses);
+
+    // 1
+    const concentFilter = { concent: { $exists: true } };
+    report.renamedConcent = await respondents.countDocuments(concentFilter);
+    if (apply && report.renamedConcent) await respondents.updateMany(concentFilter, { $rename: { concent: "consent" } });
+
+    for (const col of [users, respondents]) {
+        // 2
+        const missing = { accountStatus: { $exists: false } };
+        report.accountStatus += await col.countDocuments(missing);
+        if (apply) {
+            await col.updateMany({ ...missing, isDeleted: true }, { $set: { accountStatus: "deleted" } });
+            await col.updateMany(missing, { $set: { accountStatus: "active" } });
+        }
+        // 3
+        const cursor = col.find({ "address.0": { $exists: true } }, { projection: { address: 1 } });
+        for await (const doc of cursor) {
+            const set = {};
+            doc.address.forEach((a, i) => {
+                if (a.countryCode || !a.country) return;
+                const code = toCountryCode(a.country);
+                if (code) set[`address.${i}.countryCode`] = code;
+                else report.unmappedCountries[a.country] = (report.unmappedCountries[a.country] ?? 0) + 1;
+            });
+            if (Object.keys(set).length) {
+                report.countryCodes += 1;
+                if (apply) await col.updateOne({ _id: doc._id }, { $set: set });
+            }
+        }
+        // 5
+        if (legacyPolicy) {
+            const f = { "terms.0": { $exists: true }, "consents.purpose": { $ne: "survey_invitations" } };
+            report.legacyConsent += await col.countDocuments(f);
+            if (apply) await col.updateMany(f, [
+                { $set: { consents: { $concatArrays: [{ $ifNull: ["$consents", []] }, [{ purpose: "survey_invitations", granted: true, at: { $ifNull: ["$createdAt", "$$NOW"] }, policyVersion: legacyPolicy, channel: "legacy_terms" }]] }, "consentState.survey_invitations": true } },
+            ]);
+        }
+    }
+
+    // 4
+    const noChange = { statusChangedAt: { $exists: false } };
+    report.statusChangedAt = await responses.countDocuments(noChange);
+    if (apply && report.statusChangedAt) await responses.updateMany(noChange, [{ $set: { statusChangedAt: { $ifNull: ["$updatedAt", "$createdAt", "$$NOW"] } } }]);
+
+    log(JSON.stringify(report, null, 2));
+    if (!apply) log("Dry run: nothing written. Re-run with --apply.");
+    return report;
+}
+
+if (import.meta.url === `file://${process.argv[1]}`) {
+    if (!process.env.MONGO_URI) { console.error("Set MONGO_URI"); process.exit(1); }
+    await mongoose.connect(process.env.MONGO_URI);
+    try { await migrate(mongoose.connection.db); } finally { await mongoose.disconnect(); }
+}
