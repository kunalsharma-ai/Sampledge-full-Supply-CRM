# Root reference. Each app reads its own file: apps/api/.env (copy apps/api/.env.example).
# The web app needs no secrets; it proxies /api/v1 to API_ORIGIN (default http://localhost:4000).
API_ORIGIN="http://localhost:4000"
NEXT_PUBLIC_DEMO_LOGINS="true"   # quick demo-account buttons on /login; set false outside local demos
# Planned, not used yet:
# REDIS_URL="redis://localhost:6379"   (job queues, Phase 4)
# AI_PROVIDER / AI_API_KEY             (provider-independent AI gateway, Phase 5)
