DATABASE_URL="postgresql://sampledge:sampledge@localhost:5432/sampledge?schema=public"
JWT_SECRET="replace-with-32+-random-chars"
PORT=4000
WEB_ORIGIN="http://localhost:3000"
# Sign-in attempts per IP per minute. Default 10.
# LOGIN_RATE_LIMIT=10
# Workflow worker: runs inside the API unless set to false (then run `node dist/worker.js`).
WORKER_INLINE=true
# E-mail delivery (SMTP). Off unless SMTP_HOST and SMTP_FROM are set; until then messages are recorded, not sent.
# Only e-mail to Sampledge accounts (client/vendor contacts, internal roles) is sent; panel e-mail is not.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false        # true for port 465 (implicit TLS); 587 upgrades with STARTTLS
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM="Sampledge <noreply@example.com>"

# SMS delivery (Twilio-compatible REST API). Off unless SMS_ACCOUNT_SID, SMS_AUTH_TOKEN and SMS_FROM are set.
# Texts go to the phone numbers an administrator records in Admin & Security -> People and roles.
# SMS_ACCOUNT_SID=
# SMS_AUTH_TOKEN=
# SMS_FROM=+12025550100
# SMS_API_URL=https://api.twilio.com   # another compatible provider, or a test stand-in
# Comms Hub sends to more recipients than this need a 'High-volume communications' approval.
COMMS_HIGH_VOLUME=100
# AI gateway. Default "rules": deterministic, no model, no data leaves the system.
# "anthropic" uses Claude only when ANTHROPIC_API_KEY is also set; otherwise it stays on rules.
AI_PROVIDER=rules
# ANTHROPIC_API_KEY=
# Monthly AI spend cap in USD per tenant; at the cap tasks fall back to rules.
AI_MONTHLY_CAP_USD=50
# Single sign-on (OpenID Connect). All four required to enable; users must already belong to the workspace.
# OIDC_ISSUER=https://login.example.com
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# OIDC_REDIRECT_URI=https://app.example.com/api/v1/auth/sso/callback
# OIDC_TENANT=sampledge-demo
# OIDC_LABEL="Sign in with Example SSO"
# SAML 2.0 single sign-on (off unless all six are set; see docs/DEPLOYMENT.md)
# SAML_ENTRY_POINT=https://idp.example.com/sso/saml
# SAML_IDP_ISSUER=https://idp.example.com/metadata
# SAML_IDP_CERT="-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----"
# SAML_SP_ENTITY_ID=https://app.example.com/saml
# SAML_CALLBACK_URL=https://app.example.com/api/v1/auth/saml/acs
# SAML_TENANT=sampledge-demo
# SAML_LABEL="Sign in with Okta"
# SAML_EMAIL_ATTRIBUTE=email
# Observability: one JSON line per request, and a Prometheus endpoint at /api/v1/metrics (Bearer token).
# LOG_FORMAT=json
# METRICS_TOKEN=
# Several API instances: client address from X-Forwarded-For (number of proxy hops), and where
# rate-limit counters live (postgres = shared by all instances, the default; memory = this process only).
# TRUST_PROXY=1
# RATE_LIMIT_STORE=postgres
# Turn2Opinion panel backend (see docs/integrations/TURN2OPINION.md). A panel without both is "not connected".
# PANEL_T2O_URL=https://t2o.sampledge.duckdns.org
# PANEL_T2O_TOKEN=
# PANEL_MFR_URL=
# PANEL_MFR_TOKEN=
# PANEL_MHO_URL=
# PANEL_MHO_TOKEN=
# PANEL_BACKEND_TENANT=sampledge-demo
# PANEL_SAMPLEDGE_PATH=/api/v1/sampledge
# PANEL_IMPORT_INTERVAL_MS=300000
# PANEL_IMPORT_MAX_PAGES=20
