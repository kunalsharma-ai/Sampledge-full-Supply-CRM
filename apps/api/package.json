{
  "name": "@sampledge/api",
  "version": "0.10.0",
  "private": true,
  "main": "dist/main.js",
  "scripts": {
    "build": "prisma generate && tsc -p tsconfig.json",
    "dev": "prisma generate && tsc -p tsconfig.json && concurrently -k -n tsc,node \"tsc -p tsconfig.json -w --preserveWatchOutput\" \"node --watch dist/main.js\"",
    "start": "node dist/main.js",
    "typecheck": "prisma generate && tsc -p tsconfig.json --noEmit",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "node dist/seed.js",
    "db:setup": "prisma migrate deploy && npm run build && node dist/seed.js",
    "test": "npm run build && node --test --test-concurrency=1 dist/test/*.test.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.3.0",
    "@nestjs/common": "11.1.6",
    "@nestjs/core": "11.1.6",
    "@nestjs/jwt": "11.0.0",
    "@nestjs/platform-express": "11.1.6",
    "@nestjs/throttler": "6.4.0",
    "@prisma/client": "6.19.0",
    "@sampledge/core": "*",
    "bcryptjs": "3.0.2",
    "cookie-parser": "1.4.7",
    "dotenv": "16.4.7",
    "exceljs": "4.4.0",
    "jose": "5.9.6",
    "mammoth": "1.8.0",
    "otplib": "12.0.1",
    "pdfkit": "0.15.2",
    "pg": "8.13.1",
    "pptxgenjs": "3.12.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "unpdf": "0.12.1",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/cookie-parser": "1.4.9",
    "@types/express": "5.0.3",
    "@types/node": "22.18.0",
    "@types/pdfkit": "0.13.9",
    "@types/pg": "8.11.10",
    "concurrently": "9.2.1",
    "prisma": "6.19.0",
    "typescript": "5.9.2"
  }
}
