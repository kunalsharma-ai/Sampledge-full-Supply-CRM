// Sampledge AI Research OS: Phase 3 schema (live).
// Every business table carries tenantId; the API's TenantScope enforces it on every query
// and the isolation tests in src/test prove one tenant cannot read another's records.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ───────────────────────── Tenancy, identity, access
model Tenant {
  id          String       @id @default(cuid())
  name        String
  slug        String       @unique
  createdAt   DateTime     @default(now())
  /// Retention periods in days per category (see modules/retention.ts); a missing key means keep.
  retention      Json      @default("{}")
  retentionRunAt DateTime?
  /// Finance: amounts are reported in this currency; other currencies convert at the rates finance records
  baseCurrency   String    @default("USD")
  /// Cash value of one panel incentive point, in the base currency
  pointValue     Float     @default(0.01)
  memberships Membership[]
}

model User {
  id           String       @id @default(cuid())
  email        String       @unique
  name         String
  passwordHash String
  mfaSecret    String?
  mfaEnabled   Boolean      @default(false)
  createdAt    DateTime     @default(now())
  memberships  Membership[]
  sessions     Session[]
}

enum Role {
  platform_admin
  executive
  project_manager
  survey_programmer
  bizdev
  data_processing
  finance
  panel_manager
  vendor
  client
}

model Membership {
  id       String  @id @default(cuid())
  tenantId String
  userId   String
  role     Role
  vendorId String? // vendor users are scoped to one vendor
  clientId String? // client users are scoped to one client
  phone    String? // E.164, set by an administrator; used only for SMS from the Comms Hub
  tenant   Tenant  @relation(fields: [tenantId], references: [id])
  user     User    @relation(fields: [userId], references: [id])

  @@unique([tenantId, userId])
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  tenantId  String
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])
}

model AuditLog {
  id       String   @id @default(cuid())
  tenantId String
  actorId  String?
  actor    String
  action   String
  entity   String
  entityId String
  before   Json?
  after    Json?
  at       DateTime @default(now())

  @@index([tenantId, entity, entityId])
  @@index([tenantId, at])
}

model Notification {
  id        String   @id @default(cuid())
  tenantId  String
  roles     Role[]   // visible to these roles; empty = everyone in tenant
  title     String
  body      String
  module    String
  createdAt DateTime @default(now())
  reads     NotificationRead[]

  @@index([tenantId, createdAt])
}

/// Read state is per person: one row when a user has read a notification.
model NotificationRead {
  id             String       @id @default(cuid())
  tenantId       String
  notificationId String
  userId         String
  readAt         DateTime     @default(now())
  notification   Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)

  @@unique([notificationId, userId])
  @@index([tenantId, userId])
}

// ───────────────────────── Commercial
model Client {
  id            String        @id @default(cuid())
  tenantId      String
  name          String
  sector        String?
  currency      String        @default("USD") // invoices to this client are drafted in it
  projects      Project[]
  opportunities Opportunity[]

  @@index([tenantId])
}

enum Audience {
  B2B
  B2C
  Healthcare
}

model Opportunity {
  id          String    @id @default(cuid())
  tenantId    String
  clientId    String
  title       String
  stage       String    // New RFQ | Qualifying | Feasibility | Quote Sent | Negotiation | Won | Lost
  owner       String
  audience    Audience
  countries   String[]
  sampleSize  Int
  incidence   Float
  loi         Int
  value       Int       // USD
  margin      Float     // internal; redacted without view:margins
  probability Float
  lossReason  String?
  sourceText  String?   // Email-to-RFQ origin
  channel     String    @default("sales") // sales | diy
  projectId   String?   @unique
  createdAt   DateTime  @default(now())
  lastTouch   DateTime  @default(now())
  client      Client    @relation(fields: [clientId], references: [id])
  project     Project?  @relation(fields: [projectId], references: [id])
  quotes      Quote[]

  @@index([tenantId, stage])
}

model Quote {
  id            String      @id @default(cuid())
  tenantId      String
  opportunityId String
  version       Int
  cpiSell       Float
  cpiCost       Float       // internal; redacted without view:margins
  margin        Float
  total         Int
  basis         String      // rate_card_estimate | supplier_confirmed
  status        String      // draft | pending_approval | approved | sent | rejected
  createdBy     String
  createdAt     DateTime    @default(now())
  opportunity   Opportunity @relation(fields: [opportunityId], references: [id])

  @@unique([opportunityId, version])
}

// ───────────────────────── Projects: the shared record
model Project {
  id           String       @id @default(cuid())
  tenantId     String
  code         String
  name         String
  clientId     String
  audience     Audience
  countries    String[]
  stage        String       // lifecycle stage
  owner        String
  start        DateTime
  deadline     DateTime
  target       Int
  completes    Int          @default(0)
  ir           Float
  loi          Int
  dropout      Float        @default(0)
  quality      Float        @default(0)
  cpiSell      Float
  cpiCost      Float        // internal
  budget       Int
  costIncurred Int          @default(0)
  blockers     String[]
  createdAt    DateTime     @default(now())
  client       Client       @relation(fields: [clientId], references: [id])
  opportunity  Opportunity?
  quotas       QuotaCell[]
  allocations  Allocation[]
  surveys      Survey[]

  @@unique([tenantId, code])
  @@index([tenantId, stage])
  deliverables Deliverable[]
  reportSchedules ReportSchedule[]
}

model QuotaCell {
  id        String   @id @default(cuid())
  tenantId  String
  projectId String
  surveyId  String?
  key       String   // stable key within the survey definition
  label     String
  condition Json?    // Condition AST; null for project-level cells counted elsewhere
  target    Int
  count     Int      @default(0)
  hard      Boolean  @default(true)
  project   Project  @relation(fields: [projectId], references: [id])

  @@unique([surveyId, key])
}

// ───────────────────────── Supply
model Vendor {
  id                String       @id @default(cuid())
  tenantId          String
  name              String
  hq                String
  coverage          String[]
  audiences         Audience[]
  cpiB2C            Float
  cpiB2B            Float
  cpiHC             Float
  quality           Float
  reliability       Float
  responseRate      Float
  speed             Float
  delivered         Int          @default(0)
  pendingPayment    Int          @default(0)
  bidWinRate        Float        @default(0)
  verified          Boolean      @default(false)
  currency          String       @default("USD") // purchase orders to this vendor are raised in it
  allocations       Allocation[]

  @@index([tenantId])
}

model Allocation {
  id        String   @id @default(cuid())
  tenantId  String
  projectId String
  vendorId  String
  completes Int
  cpi       Float
  status    String   // proposed | approved | live | closed
  approvalId String?
  /// Where respondents go when they finish, set by the vendor or the project team. {rid} is
  /// replaced with the supplier's own respondent id from the entry link.
  completeUrl  String?
  screenoutUrl String?
  overquotaUrl String?
  createdAt DateTime @default(now())
  project   Project  @relation(fields: [projectId], references: [id])
  vendor    Vendor   @relation(fields: [vendorId], references: [id])
}

// ───────────────────────── Surveys
model Survey {
  id             String          @id @default(cuid())
  tenantId       String
  projectId      String?
  name           String
  status         String          // Draft | In QA | Published | Closed
  programmer     String
  currentVersion Int             @default(1)
  hoursSpent     Float           @default(0)
  complexity     Float           @default(0.3)
  completionRate Float           @default(0)
  loi            Int             @default(10)
  languages      String[]
  alerts         Int             @default(0)
  hasDefinition  Boolean         @default(false)
  questionCount  Int             @default(0)
  /// Data Processing set-up: { weighting?: { targets, stats, appliedAt, by }, codeframes?: { qid: Code[] } }
  dp             Json?
  createdAt      DateTime        @default(now())
  project        Project?        @relation(fields: [projectId], references: [id])
  versions       SurveyVersion[]
  responses      Response[]

  @@index([tenantId])
}

model SurveyVersion {
  id          String    @id @default(cuid())
  surveyId    String
  version     Int
  definition  Json
  label       String
  createdBy   String
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  survey      Survey    @relation(fields: [surveyId], references: [id])

  @@unique([surveyId, version])
}

model Response {
  id          String    @id @default(cuid())
  tenantId    String
  surveyId    String
  version     Int
  source      String    // preview | panel:<brand> | vendor:<id>
  respondent  String    // pseudonymous ref / seed
  answers     Json
  path        String[]
  cursor      String?
  outcome     String?   // complete | screenout | overquota | null while in progress
  startedAt   DateTime  @default(now())
  completedAt DateTime?
  /// Quality flags from the runtime checks: speeder, straightliner, duplicate, gibberish
  flags       String[]  @default([])
  /// set when a 'Rejecting respondents' approval removes it from results
  rejectedAt  DateTime?
  /// rim weight from Data Processing (1 = unweighted)
  weight      Float     @default(1)
  /// coded open ends: { questionId: [code, ...] }
  codes       Json?
  /// supplier entry: the allocation the respondent came through and the supplier's respondent id
  allocationId String?
  supplierRid  String?
  /// keyed hash of a first-party device cookie (never the raw value, never IP or user agent)
  deviceHash   String?
  survey      Survey    @relation(fields: [surveyId], references: [id])

  @@index([surveyId, outcome])
  @@index([surveyId, deviceHash])
}

// ───────────────────────── Panels
model Panelist {
  id                String    @id @default(cuid())
  tenantId          String
  brand             String    // turn2opinion | myfrequentrewards | myhealthopinions
  handle            String    // pseudonymous; no real PII in this system
  country           String
  ageBand           String
  gender            String
  segment           String    // consumer | professional | hcp | patient | caregiver
  status            String    // active | dormant | suspended | deletion_requested
  qualityScore      Float
  points            Int       @default(0)
  profileCompletion Float
  surveysCompleted  Int       @default(0)
  joinedAt          DateTime  @default(now())
  lastActiveAt      DateTime?
  consents          Consent[]

  @@index([tenantId, brand, status])
}

model Consent {
  id         String   @id @default(cuid())
  panelistId String
  purpose    String   // research_participation | health_data | marketing_email
  granted    Boolean
  at         DateTime @default(now())
  panelist   Panelist @relation(fields: [panelistId], references: [id])
}

// ───────────────────────── Automation & approvals
model Agent {
  id               String   @id
  tenantId         String
  name             String
  enabled          Boolean  @default(true)
  runs30d          Int
  successRate      Float
  avgSeconds       Int
  minutesSaved     Int
  costUsd30d       Float
  costCapUsd       Float
  requiresApproval String[]

  @@index([tenantId])
}

model Approval {
  id         String    @id @default(cuid())
  tenantId   String
  agentId    String?
  kind       String    // Purchasing sample | Sending binding quotations | Publishing surveys | ...
  title      String
  projectId  String?
  amount     Int?
  payload    Json?
  status     String    @default("pending")
  requestedBy String
  decidedBy  String?
  decidedAt  DateTime?
  createdAt  DateTime  @default(now())

  @@index([tenantId, status])
}

// ───────────────────────── Phase 4: events, supply confirmations, finance, comms

/// Transactional outbox: written in the same transaction as the change, processed after commit
/// by the worker (FOR UPDATE SKIP LOCKED), so side effects never run for rolled-back changes.
model OutboxEvent {
  id          String    @id @default(cuid())
  tenantId    String
  type        String
  payload     Json
  createdAt   DateTime  @default(now())
  processedAt DateTime?
  attempts    Int       @default(0)
  lockedUntil DateTime?
  lastError   String?

  @@index([processedAt, createdAt])
}

/// A feasibility/bid request to one vendor for one market. Vendors never see the client's identity.
model FeasibilityRequest {
  id            String    @id @default(cuid())
  tenantId      String
  opportunityId String
  vendorId      String
  country       String
  audience      Audience
  sampleSize    Int
  incidence     Float
  loi           Int
  status        String    // sent | responded | declined
  dueAt         DateTime
  cpi           Float?    // vendor's quoted CPI (a supplier confirmation)
  capacity      Int?
  note          String?
  respondedAt   DateTime?
  respondedBy   String?
  createdAt     DateTime  @default(now())

  @@unique([opportunityId, vendorId, country])
  @@index([tenantId, vendorId, status])
}

model PurchaseOrder {
  id           String   @id @default(cuid())
  tenantId     String
  number       String
  vendorId     String
  projectId    String
  allocationId String   @unique
  completes    Int
  cpi          Float
  amount       Int
  status       String   // issued | closed | cancelled
  currency     String   @default("USD")
  fxRate       Float    @default(1) // base currency per unit of `currency`, fixed when the PO is raised
  /// Reconciliation: completes finance accepted against the order, and when
  acceptedCompletes Int?
  reconciledAt DateTime?
  reconcileNote String?
  issuedAt     DateTime @default(now())
  payables     Payable[]

  @@unique([tenantId, number])
}

model Payable {
  id              String        @id @default(cuid())
  tenantId        String
  vendorId        String
  purchaseOrderId String
  amount          Int
  status          String        // open | pending_approval | paid
  currency        String        @default("USD")
  dueAt           DateTime
  paidAt          DateTime?
  createdAt       DateTime      @default(now())
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id])

  @@index([tenantId, status])
}

model Invoice {
  id        String    @id @default(cuid())
  tenantId  String
  number    String
  clientId  String
  projectId String
  completes Int
  cpi       Float
  amount    Int
  status    String    // draft | issued | paid | void
  currency  String    @default("USD")
  fxRate    Float     @default(1) // base currency per unit of `currency`, fixed when drafted
  issuedAt  DateTime?
  dueAt     DateTime?
  paidAt    DateTime?
  createdAt DateTime  @default(now())

  @@unique([tenantId, number])
  @@index([tenantId, status])
}

model MessageTemplate {
  id        String   @id @default(cuid())
  tenantId  String
  key       String
  name      String
  channel   String   // email | sms | in_app
  subject   String
  body      String   // supports {{var}} placeholders
  createdAt DateTime @default(now())

  @@unique([tenantId, key])
}

model Message {
  id          String    @id @default(cuid())
  tenantId    String
  channel     String    // email | sms | in_app
  audience    String    // client | vendor | panel | internal
  toRef       String    // client:<id> | vendor:<id> | panel:<brand>:<status> | role:<role>
  recipients  Int
  subject     String
  body        String
  status      String    // pending_approval | queued | delivered_dev | failed | cancelled
  adapter     String?
  approvalId  String?
  relatedType String?
  relatedId   String?
  createdBy   String
  createdAt   DateTime  @default(now())
  deliveredAt DateTime?
  error       String?

  @@index([tenantId, createdAt])
}

// ───────────────────────── AI gateway (Phase 5)
/// One row per AI task run: which provider answered, tokens, cost and outcome. Drives cost caps.
model AiCall {
  id           String   @id @default(cuid())
  tenantId     String
  userId       String
  task         String   // rfq.extract | questionnaire.structure | project.summary
  provider     String   // rules | anthropic
  model        String?
  status       String   // ok | fallback | refused | error | cap_reached
  inputTokens  Int      @default(0)
  outputTokens Int      @default(0)
  costUsd      Float    @default(0)
  ms           Int      @default(0)
  error        String?
  createdAt    DateTime @default(now())

  @@index([tenantId, createdAt])
}

/// Replay protection for retried writes: the first response to an Idempotency-Key is stored for 24 h
/// and returned again for the same key, user and request body.
model IdempotencyKey {
  id        String   @id @default(cuid())
  tenantId  String
  userId    String
  key       String
  method    String
  path      String
  bodyHash  String
  status    Int      @default(0) // 0 while the first request is running
  response  Json?
  createdAt DateTime @default(now())

  @@unique([tenantId, userId, key])
  @@index([createdAt])
}

/// Shared rate-limit counters, so limits hold across several API instances. Keys are hashes of
/// route and caller IP; no tenant data.
model RateLimitBucket {
  key          String    @id
  hits         Int
  resetAt      DateTime
  blockedUntil DateTime?

  @@index([resetAt])
}

/// Calls to the Turn2Opinion panel backend that change something there (invites, soft launch,
/// cancel). Each is created by an approved request and sent at most once by the worker.
model PanelCall {
  id          String    @id @default(cuid())
  tenantId    String
  panel       String    // t2o | mfr | mho
  action      String    // invites | soft-launch | cancel
  method      String
  path        String
  body        Json?
  status      String    @default("queued") // queued | sending | sent | failed | not_sent | needs_review
  httpStatus  Int?
  response    Json?
  error       String?
  approvalId  String?
  requestedBy String
  createdAt   DateTime  @default(now())
  completedAt DateTime?

  @@index([tenantId, createdAt])
}

/// A Sampledge project linked to a project on one of the panels, and where the response import is up to.
model PanelSync {
  id             String    @id @default(cuid())
  tenantId       String
  panel          String    // t2o | mfr | mho
  projectId      String
  pid            String    // the project's code, used as the panel's pid
  body           Json      // what was last sent
  syncedAt       DateTime?
  syncedBy       String?
  cursor         String?   // response feed position
  importedAt     DateTime?
  importError    String?
  createdAt      DateTime  @default(now())

  @@unique([tenantId, panel, projectId])
}

/// One respondent's outcome on a panel, as the panel reported it. Pseudonymous: respondentID only.
model PanelResponse {
  id             String    @id @default(cuid())
  tenantId       String
  panel          String
  projectId      String
  responseID     String    // the panel's id for the response
  respondentID   String?
  marketID       String?
  quotaID        String?
  status         String    // invited | started | complete | terminate | overquota | qualityterminate | dropout
  qualityReasons String[]  @default([])
  startedAt      DateTime?
  endedAt        DateTime?
  loiMinutes     Float?
  deviceType     String?
  points         Int       @default(0)
  profile        Json?     // countryCode, region, ageBand, gender, category
  panelUpdatedAt DateTime?
  importedAt     DateTime  @default(now())

  @@unique([tenantId, panel, responseID])
  @@index([tenantId, projectId, status])
}

/// SAML request IDs and used assertions, shared by every API instance. Not tenant data.
model SamlCache {
  key       String   @id
  value     String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([expiresAt])
}

/// A file released to a client: generated once at release, stored with its SHA-256.
model Deliverable {
  id          String    @id @default(cuid())
  tenantId    String
  projectId   String
  surveyId    String?
  kind        String    // report_pdf | report_pptx | tables_xlsx | responses_csv | data_sav
  title       String
  note        String?
  fileName    String
  contentType String
  size        Int
  sha256      String
  content     Bytes
  status      String    // pending_approval | released | rejected | withdrawn
  approvalId  String?
  createdBy   String
  createdById String
  createdAt   DateTime  @default(now())
  releasedAt  DateTime?
  withdrawnAt DateTime?
  downloads   Int       @default(0)
  project     Project   @relation(fields: [projectId], references: [id])

  @@index([tenantId, projectId, status])
}

/// A recurring release of a survey's report or tables to the client (see modules/report-schedules.ts).
model ReportSchedule {
  id                String    @id @default(cuid())
  tenantId          String
  projectId         String
  surveyId          String
  kind              String    // report_pdf | report_pptx | tables_xlsx
  frequency         String    // daily | weekly
  weekday           Int?      // 0 = Sunday, weekly only
  hourUtc           Int
  active            Boolean   @default(true)
  createdBy         String
  createdById       String
  nextRunAt         DateTime
  lastRunAt         DateTime?
  lastResult        String?
  lastDeliverableId String?
  createdAt         DateTime  @default(now())
  project           Project   @relation(fields: [projectId], references: [id])

  @@index([active, nextRunAt])
}

/// Exchange rates finance records (no market feed is connected). The latest effective rate applies to new documents.
model ExchangeRate {
  id            String   @id @default(cuid())
  tenantId      String
  currency      String
  rate          Float    // base currency per 1 unit of `currency`
  effectiveFrom DateTime @default(now())
  setBy         String
  createdAt     DateTime @default(now())

  @@index([tenantId, currency, effectiveFrom])
}

/// Panel incentives: points earned, redeemed, adjusted or expired per panel member. Redemptions are paid out, so they need an 'Issuing payments' approval.
model IncentiveEntry {
  id         String   @id @default(cuid())
  tenantId   String
  panelistId String
  kind       String   // earn | redeem | adjust | expire
  points     Int      // signed: earn positive, redeem and expire negative
  valueBase  Float    // points x the point value at the time, in the base currency
  status     String   @default("posted") // posted | pending_approval | rejected
  projectId  String?
  note       String?
  approvalId String?
  createdBy  String
  createdAt  DateTime @default(now())

  @@index([tenantId, panelistId])
  @@index([tenantId, createdAt])
}
